# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
# Preserve hard line breaks (two trailing spaces) in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
